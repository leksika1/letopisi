{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letopisi.local/contracts/observation.schema.json",
  "title": "Observation",
  "description": "Запись наблюдения, извлечённая из летописи природы. Источник правды: docs/SPEC.md, раздел «Модель записи». Значения, которых нет в тексте, — null (не додумываются).",
  "$ref": "#/$defs/Observation",
  "$defs": {
    "Id": {
      "description": "Целочисленный идентификатор (bigint в БД).",
      "type": "integer",
      "minimum": 1
    },
    "NullableId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "RecordType": {
      "description": "observation — наблюдение вида/явления; env_measurement — погода, вода, снег; publication — публикация (библиография, раздел «Научные исследования»).",
      "type": "string",
      "enum": [
        "observation",
        "env_measurement",
        "publication"
      ]
    },
    "ObjectType": {
      "type": "string",
      "enum": [
        "taxon",
        "phenomenon",
        "env_indicator",
        "publication"
      ]
    },
    "DatePrecision": {
      "description": "Точность даты. null — даты нет (например, у публикации).",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "day",
        "decade",
        "month",
        "season",
        "year",
        "range",
        null
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "auto",
        "verified",
        "edited",
        "rejected"
      ]
    },
    "Flag": {
      "type": "string",
      "enum": [
        "quote_not_found",
        "value_not_in_quote",
        "date_not_in_quote",
        "date_ambiguous",
        "taxon_unmatched",
        "taxon_ambiguous",
        "place_unmatched",
        "person_unmatched",
        "year_outside_book",
        "low_ocr",
        "table_parse_uncertain"
      ]
    },
    "TaxonGroup": {
      "type": "string",
      "enum": [
        "сосудистые растения",
        "мхи",
        "лишайники",
        "грибы",
        "птицы",
        "млекопитающие",
        "рыбы",
        "амфибии и рептилии",
        "насекомые",
        "прочие беспозвоночные"
      ]
    },
    "BBox": {
      "description": "Прямоугольник [x0, y0, x1, y1] в долях ширины/высоты страницы PDF (0..1), начало координат — левый верхний угол. Для сканов-разворотов — доли всей страницы-разворота.",
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "Locator": {
      "description": "Положение фрагмента в исходном документе. Вариант зависит от формата документа.",
      "oneOf": [
        {
          "$ref": "#/$defs/PdfLocator"
        },
        {
          "$ref": "#/$defs/DocxParaLocator"
        },
        {
          "$ref": "#/$defs/DocxTableLocator"
        },
        {
          "$ref": "#/$defs/XlsxLocator"
        }
      ]
    },
    "PdfLocator": {
      "type": "object",
      "properties": {
        "pdf_page": {
          "description": "Номер страницы PDF, с 1. null — не удалось определить.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "half": {
          "description": "Половина разворота для сканов (L/R); null — страница не разворот или фрагмент на обеих половинах.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "L",
            "R",
            null
          ]
        },
        "printed_page": {
          "description": "Печатный номер страницы книги, как напечатан (строка; может быть диапазоном «76-77»).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pdf_page",
        "half",
        "printed_page"
      ],
      "additionalProperties": false
    },
    "DocxParaLocator": {
      "type": "object",
      "properties": {
        "para": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "para"
      ],
      "additionalProperties": false
    },
    "DocxTableLocator": {
      "type": "object",
      "properties": {
        "table": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "table",
        "row"
      ],
      "additionalProperties": false
    },
    "XlsxLocator": {
      "type": "object",
      "properties": {
        "sheet": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "sheet",
        "row"
      ],
      "additionalProperties": false
    },
    "ObservationCore": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "record_type": {
          "$ref": "#/$defs/RecordType"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "object_raw": {
          "description": "Объект как в тексте (название вида, явления, показателя, заголовок публикации).",
          "type": "string",
          "minLength": 1
        },
        "taxon_id": {
          "$ref": "#/$defs/NullableId"
        },
        "date_raw": {
          "description": "Дата как в тексте.",
          "type": [
            "string",
            "null"
          ]
        },
        "date_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_precision": {
          "$ref": "#/$defs/DatePrecision"
        },
        "obs_year": {
          "description": "Год наблюдения (может отличаться от года книги). Для публикаций — год публикации.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        },
        "toponym_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "place_id": {
          "$ref": "#/$defs/NullableId"
        },
        "coords_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "habitat_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_raw": {
          "description": "«Характер явления, наблюдения».",
          "type": [
            "string",
            "null"
          ]
        },
        "phenophase_id": {
          "$ref": "#/$defs/NullableId"
        },
        "phenophase_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "indicator": {
          "description": "Что измеряли (например «следов на 10 км маршрута», «высота снега»).",
          "type": [
            "string",
            "null"
          ]
        },
        "value_num": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "observers_raw": {
          "description": "Наблюдатели как в тексте.",
          "type": [
            "string",
            "null"
          ]
        },
        "person_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "pub_authors": {
          "description": "Только для record_type=publication: авторы как в тексте.",
          "type": [
            "string",
            "null"
          ]
        },
        "pub_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        },
        "pub_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "pub_venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_id": {
          "$ref": "#/$defs/Id"
        },
        "section_id": {
          "$ref": "#/$defs/NullableId"
        },
        "chunk_id": {
          "$ref": "#/$defs/NullableId"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "printed_pages": {
          "description": "Ссылка на страницу/-цы как в шаблоне: «76-77», «71».",
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "description": "Дословная цитата из text соответствующего chunk.",
          "type": [
            "string",
            "null"
          ]
        },
        "quote_span": {
          "description": "[start, end) — смещения quote в chunk.text (в символах Unicode, end не включается): chunk.text[start:end] == quote.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bboxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BBox"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Flag"
          },
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "extractor_version": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "record_type",
        "object_type",
        "object_raw",
        "taxon_id",
        "date_raw",
        "date_from",
        "date_to",
        "date_precision",
        "obs_year",
        "toponym_raw",
        "place_id",
        "coords_raw",
        "habitat_raw",
        "event_raw",
        "phenophase_id",
        "phenophase_raw",
        "indicator",
        "value_num",
        "value_raw",
        "unit",
        "observers_raw",
        "person_ids",
        "pub_authors",
        "pub_year",
        "pub_title",
        "pub_venue",
        "document_id",
        "section_id",
        "chunk_id",
        "locator",
        "printed_pages",
        "quote",
        "quote_span",
        "bboxes",
        "note",
        "confidence",
        "flags",
        "status",
        "extractor_version"
      ],
      "description": "Поля записи наблюдения (без ограничения лишних полей; используется через allOf)."
    },
    "Observation": {
      "description": "Запись наблюдения (строка таблицы observations + person_ids из observation_persons).",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/ObservationCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "ObservationLabels": {
      "description": "Человекочитаемые подписи, которые API добавляет к записи в списке (вычисляются джойнами, в БД не хранятся).",
      "type": "object",
      "properties": {
        "taxon_name_ru": {
          "type": [
            "string",
            "null"
          ]
        },
        "taxon_name_lat": {
          "type": [
            "string",
            "null"
          ]
        },
        "taxon_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaxonGroup"
            },
            {
              "type": "null"
            }
          ]
        },
        "place_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "phenophase_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "phenophase_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "persons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "document_title": {
          "type": "string"
        },
        "book_no": {
          "type": [
            "integer",
            "null"
          ]
        },
        "book_year": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "taxon_name_ru",
        "taxon_name_lat",
        "taxon_group",
        "place_name",
        "phenophase_code",
        "phenophase_name",
        "persons",
        "document_title",
        "book_no",
        "book_year"
      ],
      "additionalProperties": false
    },
    "ObservationListItem": {
      "description": "Элемент списка GET /observations: запись + подписи.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/ObservationCore"
        }
      ],
      "properties": {
        "labels": {
          "$ref": "#/$defs/ObservationLabels"
        }
      },
      "required": [
        "labels"
      ],
      "unevaluatedProperties": false
    },
    "ObservationEditableFields": {
      "description": "Поля, которые можно менять через PATCH /observations/{id}. Источник (document_id, chunk_id, locator, quote_span), status и служебные поля меняет только сервер.",
      "type": "object",
      "properties": {
        "record_type": {
          "$ref": "#/$defs/RecordType"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "object_raw": {
          "type": "string",
          "minLength": 1
        },
        "taxon_id": {
          "$ref": "#/$defs/NullableId"
        },
        "date_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_precision": {
          "$ref": "#/$defs/DatePrecision"
        },
        "obs_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        },
        "toponym_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "place_id": {
          "$ref": "#/$defs/NullableId"
        },
        "coords_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "habitat_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "phenophase_id": {
          "$ref": "#/$defs/NullableId"
        },
        "phenophase_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "indicator": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_num": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "observers_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "person_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "pub_authors": {
          "type": [
            "string",
            "null"
          ]
        },
        "pub_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        },
        "pub_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "pub_venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "printed_pages": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Flag"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ObservationPatch": {
      "description": "Тело PATCH /observations/{id}. action=edit → status=edited; verify → verified (fields можно не передавать); reject → rejected.",
      "type": "object",
      "properties": {
        "fields": {
          "$ref": "#/$defs/ObservationEditableFields"
        },
        "action": {
          "type": "string",
          "enum": [
            "edit",
            "verify",
            "reject"
          ]
        },
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "editor"
      ],
      "additionalProperties": false
    },
    "FieldChange": {
      "type": "object",
      "properties": {
        "old": {},
        "new": {}
      },
      "required": [
        "old",
        "new"
      ],
      "additionalProperties": false
    },
    "ObservationEdit": {
      "description": "Запись журнала правок (таблица observation_edits).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "observation_id": {
          "$ref": "#/$defs/Id"
        },
        "action": {
          "type": "string",
          "enum": [
            "edit",
            "verify",
            "reject"
          ]
        },
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "description": "Изменённые поля: {имя_поля: {old, new}}. Для verify/reject — пустой объект.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/EditableFieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FieldChange"
          }
        },
        "status_before": {
          "$ref": "#/$defs/Status"
        },
        "status_after": {
          "$ref": "#/$defs/Status"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "observation_id",
        "action",
        "editor",
        "changes",
        "status_before",
        "status_after",
        "comment",
        "created_at"
      ],
      "additionalProperties": false
    },
    "EditableFieldName": {
      "type": "string",
      "enum": [
        "record_type",
        "object_type",
        "object_raw",
        "taxon_id",
        "date_raw",
        "date_from",
        "date_to",
        "date_precision",
        "obs_year",
        "toponym_raw",
        "place_id",
        "coords_raw",
        "habitat_raw",
        "event_raw",
        "phenophase_id",
        "phenophase_raw",
        "indicator",
        "value_num",
        "value_raw",
        "unit",
        "observers_raw",
        "person_ids",
        "pub_authors",
        "pub_year",
        "pub_title",
        "pub_venue",
        "printed_pages",
        "note",
        "flags"
      ]
    },
    "DocumentFormat": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "xlsx"
      ]
    },
    "DocumentStatus": {
      "description": "queued — загружен, ждёт обработки; processing; done; failed — ошибка; unsupported — формат/содержимое не поддерживается.",
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "done",
        "failed",
        "unsupported"
      ]
    },
    "Document": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "book_no": {
          "description": "Номер книги (тома) летописи; null для документов вне серии (например xlsx с параметрами).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "year": {
          "description": "Год, за который составлена книга.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        },
        "filename": {
          "description": "Имя файла в data/raw.",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/DocumentFormat"
        },
        "pages": {
          "description": "Число страниц PDF; null для docx/xlsx.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "has_text_layer": {
          "type": "boolean"
        },
        "layout": {
          "description": "single — одна страница книги на страницу PDF; spread — разворот из двух страниц.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
