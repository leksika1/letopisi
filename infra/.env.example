# Local development. For a VM, set the password in both values before first startup.
POSTGRES_PASSWORD=letopisi
DATABASE_URL=postgresql+psycopg://letopisi:letopisi@postgres:5432/letopisi

# Optional for the fixture loader and health endpoint.
YC_FOLDER_ID=
YC_API_KEY=
# Search uses local parsing rules by default. OCR is controlled by YC_API_KEY.
LLM_BACKEND=mock
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
